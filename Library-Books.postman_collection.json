{
  "info": {
    "name": "Library Management System - Books",
    "description": "Book CRUD endpoints (Day 1-2). Set the collection variables `base_url` and `token` before running. Create Book auto-saves the new id into `bookId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:2000" },
    { "key": "token", "value": "PASTE_YOUR_JWT_HERE" },
    { "key": "bookId", "value": "" }
  ],
  "item": [
    {
      "name": "Get All Books (pagination + filters)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "title", "value": "clean", "disabled": true },
            { "key": "category", "value": "programming", "disabled": true },
            { "key": "author", "value": "", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/{{bookId}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{bookId}}"]
        }
      }
    },
    {
      "name": "Create Book (auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let j = pm.response.json();",
              "if (j.book && j.book._id) {",
              "  pm.collectionVariables.set('bookId', j.book._id);",
              "  console.log('Saved bookId =', j.book._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"000000000000000000000abc\",\n  \"isbn\": \"978-0132350884\",\n  \"category\": \"Programming\",\n  \"publishedYear\": 2008,\n  \"publisher\": \"Prentice Hall\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "Update Book (auth)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Software Engineering\",\n  \"availableCopies\": 3\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/{{bookId}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{bookId}}"]
        }
      }
    },
    {
      "name": "Delete Book (auth)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/books/{{bookId}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{bookId}}"]
        }
      }
    },
    {
      "name": "Create Book WITHOUT token (expect 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"No Auth Book\",\n  \"author\": \"000000000000000000000abc\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "Create Book missing title (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"000000000000000000000abc\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    }
  ]
}
