      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fresh email each run so it doesn't 409",
                  "pm.collectionVariables.set('email', 'lib_' + Date.now() + '@example.com');",
                  "pm.collectionVariables.set('password', 'secret123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('has message', () => pm.expect(j.message).to.eql('User registered successfully'));",
                  "pm.test('returns a token', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.test('user has _id', () => pm.expect(j.user._id).to.be.a('string'));",
                  "pm.test('password is not returned', () => pm.expect(j.user).to.not.have.property('password'));",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.collectionVariables.set('userId', j.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('login message', () => pm.expect(j.message).to.eql('Login successful'));",
                  "pm.test('returns a token', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', j.token);"
